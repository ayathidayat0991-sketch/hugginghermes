# LLM / Hermes
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o
GATEWAY_TOKEN=
HF_TOKEN=

# WhatsApp Cloud API (default chat adapter)
WHATSAPP_PROVIDER=cloud
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALLOWED_NUMBERS=6281234567890,6289876543210
WHATSAPP_GRAPH_API_VERSION=v20.0
# Optional: validates X-Hub-Signature-256 when set to your Meta App Secret.
WHATSAPP_APP_SECRET=
# Optional: send a short denial message to non-whitelisted numbers.
WHATSAPP_REJECT_UNAUTHORIZED=false

# Optional Telegram backward compatibility
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
CLOUDFLARE_WORKERS_TOKEN=
